#!/usr/bin/env bash
# Refresh hyprsunset profiles from today's sunrise/sunset at the weather location.
set -euo pipefail

CONF="${HYPRSUNSET_CONF:-$HOME/.config/hypr/hyprsunset.conf}"
LOC_FILE="${OMARCHY_WEATHER_LOCATION:-$HOME/.local/state/omarchy/settings/weather.json}"
UNIT_DIR="${HYPRSUNSET_SOLAR_UNIT_DIR:-$HOME/.config/systemd/user}"
NIGHT_TEMP=4000
# Omarchy's bar and `omarchy toggle nightlight --status` treat temperature
# < 6000K as nightlight-on. Identity alone leaves the last night temperature
# in the IPC reading, so the screen goes daylight while the indicator stays on.
DAY_TEMP=6500
SKIP_DAEMON="${HYPRSUNSET_SOLAR_SKIP_DAEMON:-0}"

apply_current() {
  local i
  for i in {1..10}; do
    if hyprctl hyprsunset reset >/dev/null 2>&1; then
      break
    fi
    sleep 0.3
  done
  omarchy-shell -q nightlight refresh >/dev/null 2>&1 || true
}

watch_resume() {
  # PrepareForSleep true = going to sleep; false = resumed.
  dbus-monitor --system \
    "type='signal',interface='org.freedesktop.login1.Manager',member='PrepareForSleep'" \
    2>/dev/null |
    while IFS= read -r line; do
      if [[ $line == *"boolean false"* ]]; then
        sleep 0.5
        apply_current
      fi
    done
}

case ${1:-} in
apply)
  apply_current
  exit 0
  ;;
watch-resume)
  watch_resume
  exit 0
  ;;
esac

if [[ ! -f $LOC_FILE ]]; then
  echo "hyprsunset-solar: no weather location at $LOC_FILE" >&2
  exit 1
fi

lat=$(jq -er '.latitude | select(type=="number")' "$LOC_FILE")
lon=$(jq -er '.longitude | select(type=="number")' "$LOC_FILE")
name=$(jq -r '.name // "unknown"' "$LOC_FILE")

sunrise=""
sunset=""

if json=$(curl -fsS --max-time 8 \
  "https://api.open-meteo.com/v1/forecast?latitude=${lat}&longitude=${lon}&daily=sunrise,sunset&timezone=auto&forecast_days=1" \
  2>/dev/null); then
  sunrise=$(jq -r '.daily.sunrise[0] // empty' <<<"$json")
  sunset=$(jq -r '.daily.sunset[0] // empty' <<<"$json")
  sunrise=${sunrise##*T}
  sunrise=${sunrise:0:5}
  sunset=${sunset##*T}
  sunset=${sunset:0:5}
fi

if [[ ! $sunrise =~ ^[0-9]{2}:[0-9]{2}$ || ! $sunset =~ ^[0-9]{2}:[0-9]{2}$ ]]; then
  read -r sunrise sunset < <(python3 - "$lat" "$lon" <<'PY'
import math, sys
from datetime import date, datetime, timezone

lat = float(sys.argv[1])
lon = float(sys.argv[2])
day = date.today()
local_tz = datetime.now().astimezone().tzinfo

a = (14 - day.month) // 12
y = day.year + 4800 - a
m = day.month + 12 * a - 3
jd = day.day + (153 * m + 2) // 5 + 365 * y + y // 4 - y // 100 + y // 400 - 32045
n = jd - 2451545.0 + 0.0008
jstar = n - lon / 360.0
M = (357.5291 + 0.98560028 * jstar) % 360
C = (1.9148 * math.sin(math.radians(M))
     + 0.0200 * math.sin(math.radians(2 * M))
     + 0.0003 * math.sin(math.radians(3 * M)))
lam = (M + C + 180 + 102.9372) % 360
jtransit = 2451545.0 + jstar + 0.0053 * math.sin(math.radians(M)) - 0.0069 * math.sin(math.radians(2 * lam))
delta = math.asin(math.sin(math.radians(lam)) * math.sin(math.radians(23.4397)))
lat_r = math.radians(lat)
arg = (math.sin(math.radians(-0.833)) - math.sin(lat_r) * math.sin(delta)) / (math.cos(lat_r) * math.cos(delta))
arg = max(-1.0, min(1.0, arg))
omega = math.degrees(math.acos(arg))

def hm(jd):
    unix = (jd - 2440587.5) * 86400.0
    return datetime.fromtimestamp(unix, tz=timezone.utc).astimezone(local_tz).strftime("%H:%M")

print(hm(jtransit - omega / 360.0), hm(jtransit + omega / 360.0))
PY
)
fi

if [[ ! $sunrise =~ ^[0-9]{2}:[0-9]{2}$ || ! $sunset =~ ^[0-9]{2}:[0-9]{2}$ ]]; then
  echo "hyprsunset-solar: could not get sunrise/sunset for $name" >&2
  exit 1
fi

if [[ $sunrise == "$sunset" ]]; then
  echo "hyprsunset-solar: sunrise and sunset are the same ($sunrise); not writing" >&2
  exit 1
fi

new=$(mktemp)
trap 'rm -f "$new"' EXIT
cat >"$new" <<EOF
# Managed by hyprsunset-solar from the weather location ($name).
# Off at sunrise ($sunrise), on at sunset ($sunset) at ${NIGHT_TEMP}K.
# Day reports ${DAY_TEMP}K so Omarchy's nightlight indicator matches the screen.

profile {
    time = $sunrise
    temperature = $DAY_TEMP
    identity = true
}

profile {
    time = $sunset
    temperature = $NIGHT_TEMP
}
EOF

mkdir -p "$(dirname "$CONF")"
changed=0
if [[ ! -f $CONF ]] || ! cmp -s "$new" "$CONF"; then
  cp "$new" "$CONF"
  changed=1
fi

echo "hyprsunset-solar: $name  off $sunrise  on $sunset  temp ${NIGHT_TEMP}K"

if [[ $SKIP_DAEMON != 0 ]]; then
  exit 0
fi

write_switch_timer() {
  local kind=$1 hhmm=$2
  local unit="hyprsunset-solar-${kind}.timer"
  local path="$UNIT_DIR/$unit"
  local new_timer
  mkdir -p "$UNIT_DIR"
  new_timer=$(mktemp)
  cat >"$new_timer" <<EOF
[Unit]
Description=Apply hyprsunset $kind profile and refresh the bar indicator

[Timer]
OnCalendar=*-*-* ${hhmm}:00
AccuracySec=1s
Persistent=true
Unit=hyprsunset-solar-apply.service

[Install]
WantedBy=timers.target
EOF
  if [[ ! -f $path ]] || ! cmp -s "$new_timer" "$path"; then
    cp "$new_timer" "$path"
    rm -f "$new_timer"
    return 0
  fi
  rm -f "$new_timer"
  return 1
}

ensure_hyprsunset() {
  local i
  if pgrep -x hyprsunset >/dev/null && hyprctl hyprsunset temperature >/dev/null 2>&1; then
    return 0
  fi

  pkill -x hyprsunset >/dev/null 2>&1 || true
  for i in {1..25}; do
    pgrep -x hyprsunset >/dev/null || break
    sleep 0.1
  done

  setsid uwsm-app -- hyprsunset >/dev/null 2>&1 &
  for i in {1..25}; do
    if hyprctl hyprsunset temperature >/dev/null 2>&1; then
      return 0
    fi
    sleep 0.2
  done

  echo "hyprsunset-solar: hyprsunset did not come up" >&2
  return 1
}

running=0
if pgrep -x hyprsunset >/dev/null && hyprctl hyprsunset temperature >/dev/null 2>&1; then
  running=1
fi

if (( changed || ! running )); then
  if (( changed )); then
    pkill -x hyprsunset >/dev/null 2>&1 || true
    for i in {1..25}; do
      pgrep -x hyprsunset >/dev/null || break
      sleep 0.1
    done
  fi
  ensure_hyprsunset || true
fi

timers_changed=0
write_switch_timer sunrise "$sunrise" && timers_changed=1 || true
write_switch_timer sunset "$sunset" && timers_changed=1 || true
if (( timers_changed )); then
  systemctl --user daemon-reload >/dev/null 2>&1 || true
fi
systemctl --user enable --now hyprsunset-solar-sunrise.timer >/dev/null 2>&1 || true
systemctl --user enable --now hyprsunset-solar-sunset.timer >/dev/null 2>&1 || true

apply_current
