#!/bin/bash
# Strip setuid/setgid on the VM dirs before Omarchy's start helper runs.
# That helper does `chmod 0700`, which GNU chmod leaves setgid on directories,
# then requires mode to be exactly 0700 — so a Nautilus/archive copy that
# brought setgid along would abort launch. Symbolic chmod actually clears it.
chmod u=rwx,go=,a-s -- "$HOME/Windows" "$HOME/.windows" 2>/dev/null || true
exec /usr/bin/omarchy-windows-vm "$@"
