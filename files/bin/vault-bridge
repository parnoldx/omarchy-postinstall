SOCK_PATH = RUNTIME / "agent.sock"
PID_PATH = RUNTIME / "agent.pid"
RBW_CONFIG = Path.home() / ".config" / "rbw" / "config.json"
RBW_CACHE_DIR = Path.home() / ".cache" / "rbw"
REAL_PINENTRY = os.environ.get("VAULT_BRIDGE_PINENTRY") or "/usr/bin/pinentry"
BRIDGE_BIN = Path.home() / ".local" / "bin" / "vault-bridge"
# Leftovers from when pinentry and the native host were separate wrappers.
OLD_WRAPPERS = (
    Path.home() / ".local" / "bin" / "vault-pinentry",
    Path.home() / ".local" / "bin" / "vault-bitwarden-host",
)
COMMANDS = (
    "agent",
    "pinentry",
    "host",
    "setup",
    "status",
    "unlock",
    "lock",
    "selftest",
)

BITWARDEN_ORIGINS = [
