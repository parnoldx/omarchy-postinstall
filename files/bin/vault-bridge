#!/usr/bin/env python3
"""One master-password prompt unlocks rbw and the Bitwarden browser extension.

The Chrome extension will not accept rbw's session. It will, however, accept
the vault UserKey over the same native-messaging protocol the official desktop
app uses for biometric unlock. This process:

  * sits in as rbw's pinentry so the password is entered once
  * derives the UserKey from rbw's local cache (same KDF as Bitwarden)
  * answers the extension's biometric-unlock request with that key

The master password is never written to disk. The UserKey lives only in the
agent's memory until lock / logout / reboot.

One binary: rbw pinentry and the Chrome native-messaging host both exec
vault-bridge (detected from argv). Subcommands: agent, pinentry, host,
unlock, lock, status, setup, selftest.
"""

from __future__ import annotations

import base64
import hashlib
import hmac
import json
import os
import socket
import struct
import subprocess
import sys
import tempfile
import threading
import time
from ctypes import (
    CDLL,
    POINTER,
    byref,
    c_char_p,
    c_int,
    c_void_p,
    create_string_buffer,
)
from pathlib import Path

