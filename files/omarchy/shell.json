{
  "version": 1,
  "idle": {
    "screensaver": 150,
    "lock": 300
  },
  "bar": {
    "position": "top",
    "transparent": true,
    "centerAnchor": "mailbox.clock",
    "layout": {
      "left": [
        {
          "id": "pa.menu"
        },
        {
          "id": "omarchy.workspaces"
        },
        {
          "id": "io.github.itsdotdev.youtube-music"
        }
      ],
      "center": [
        {
          "id": "omarchy.indicators",
          "items": [
            "ScreenRecording",
            "Reminder",
            "NightLight",
            "Dnd",
            "StayAwake"
          ]
        },
        {
          "id": "voxtype",
          "type": "qml"
        },
        {
          "id": "omarchy.keyboard-layout"
        },
        {
          "id": "mailbox.clock",
          "format": "ddd d HH:mm",
          "formatAlt": "d MMMM 'W'ww yyyy",
          "verticalFormat": "HH\n—\nmm",
          "birthYear": 0,
          "lifeExpectancy": 85,
          "announceLeadMinutes": 5
        },
        {
          "id": "pa.weather",
          "roomEntity": "sensor.tvr_temperature",
          "duskEntity": "sensor.sun_next_dusk"
        },
        {
          "id": "omarchy.system-update"
        },
        {
          "id": "mailbox.email",
          "hideWhenEmpty": true,
          "notify": false,
          "openCommand": ""
        }
      ],
      "right": [
        {
          "id": "pa.tray",
          "pinned": [],
          "hidden": [
            "Antigravity_status_icon_1"
          ]
        },
        {
          "id": "pa.chord-expander"
        },
        {
          "id": "omarchy.bluetooth"
        },
        {
          "id": "jankeesvw.time-machine"
        },
        {
          "id": "omarchy.monitor"
        },
        {
          "id": "omarchy.dropbox"
        },
        {
          "id": "tiedeyez.omatree"
        },
        {
          "id": "jrmmhm.pocket",
          "members": "pa.chord-expander, omarchy.bluetooth, jankeesvw.time-machine, omarchy.monitor, omarchy.dropbox, tiedeyez.omatree"
        },
        {
          "id": "pa.agents"
        },
        {
          "id": "omarchy.network"
        },
        {
          "id": "gigasolo.omavoice",
          "preset": "clean",
          "previousAudioSource": "alsa_input.pci-0000_00_1f.3-platform-skl_hda_dsp_generic.HiFi__Mic1__source",
          "enabled": true
        },
        {
          "id": "omarchy.audio"
        },
        {
          "id": "omarchy.power",
          "showPercentage": true
        }
      ]
    }
  },
  "plugins": [
    {
      "id": "andreconde.quick-look"
    },
    {
      "id": "pa.todo"
    },
    {
      "id": "firstpick.keybindings"
    },
    {
      "id": "pa.dictation-answer"
    }
  ],
  "disabledPlugins": [
    "omarchy.menu"
  ],
  "cloneSourceRestores": [
    "pa.menu"
  ]
}
