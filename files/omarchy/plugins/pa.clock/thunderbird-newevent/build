#!/usr/bin/env bash
# Pack the add-on into an installable .xpi next to the plugin sources.
#
# Unsigned is fine here: Arch's Thunderbird is built with MOZ_REQUIRE_SIGNING
# off, so an add-on installed from a file loads as-is.
set -euo pipefail

here="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
xpi="$here/../thunderbird-newevent.xpi"

rm -f "$xpi"
# Zipped from inside the directory: manifest.json has to sit at the archive
# root, not under a folder.
(cd "$here" && zip -q -r -X "$xpi" manifest.json schema.json api.js background.js)

echo "$xpi"
