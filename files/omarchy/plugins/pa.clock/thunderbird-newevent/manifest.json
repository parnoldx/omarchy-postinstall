{
  "manifest_version": 2,
  "name": "Omarchy Clock — New Event",
  "version": "1.3.0",
  "description": "Creates events and tasks the Omarchy clock widget asks for, silently, and still opens the New Event dialog for a bare date.",
  "browser_specific_settings": {
    "gecko": {
      "id": "omarchy-clock-newevent@pa.local",
      "strict_min_version": "128.0"
    }
  },
  "background": {
    "scripts": ["background.js"]
  },
  "experiment_apis": {
    "omarchyNewEvent": {
      "schema": "schema.json",
      "parent": {
        "scopes": ["addon_parent"],
        "paths": [["omarchyNewEvent"]],
        "script": "api.js"
      }
    }
  }
}
