#!/usr/bin/env python3
"""Stream Handy dictation state as one word per line: idle, recording, transcribing."""

from __future__ import annotations

import os
import re
import struct
import subprocess
import sys
import time
import zlib

WATCHER = ("org.kde.StatusNotifierWatcher", "/StatusNotifierWatcher",
           "org.kde.StatusNotifierWatcher")


def busctl(*args: str) -> str:
    try:
        return subprocess.check_output(
            ["busctl", "--user", "--timeout=1", *args],
            text=True,
            stderr=subprocess.DEVNULL,
        )
    except (subprocess.CalledProcessError, FileNotFoundError):
        return ""


def registered_items() -> list[tuple[str, str]]:
    raw = busctl(
        "get-property",
        WATCHER[0],
        WATCHER[1],
        WATCHER[2],
        "RegisteredStatusNotifierItems",
    )
    items = []
    for full in re.findall(r'"([^"]+)"', raw):
        if "/" not in full:
            continue
        dest, path = full.split("/", 1)
        items.append((dest, "/" + path))
    return items


def item_prop(dest: str, path: str, prop: str) -> str:
    raw = busctl("get-property", dest, path, "org.kde.StatusNotifierItem", prop)
    match = re.search(r'"([^"]*)"', raw)
    return match.group(1) if match else ""


def find_handy() -> tuple[str, str] | None:
    for dest, path in registered_items():
        title = item_prop(dest, path, "Title").lower()
        item_id = item_prop(dest, path, "Id").lower()
        if "handy" in title or "handy" in item_id:
            return dest, path
    return None


def opaque_pixels(path: str) -> int | None:
    try:
        with open(path, "rb") as handle:
            data = handle.read()
    except OSError:
        return None
    if data[:8] != b"\x89PNG\r\n\x1a\n":
        return None

    index = 8
    width = height = bit_depth = color_type = None
    idat = b""
    plte = None
    trns = None
    while index < len(data):
        length = struct.unpack(">I", data[index:index + 4])[0]
        index += 4
        ctype = data[index:index + 4]
        index += 4
        chunk = data[index:index + length]
        index += length + 4
        if ctype == b"IHDR":
            width, height, bit_depth, color_type = struct.unpack(">IIBB", chunk[:10])
        elif ctype == b"PLTE":
            plte = chunk
        elif ctype == b"tRNS":
            trns = chunk
        elif ctype == b"IDAT":
            idat += chunk
        elif ctype == b"IEND":
            break
    if width is None or color_type is None or not idat:
        return None

    raw = zlib.decompress(idat)
    bpp = 1 if color_type == 3 else {0: 1, 2: 3, 4: 2, 6: 4}[color_type] * (bit_depth // 8)
    stride = width * bpp
    rows = []
    prev = bytearray(stride)
    offset = 0
    for _ in range(height):
        filt = raw[offset]
        offset += 1
        row = bytearray(raw[offset:offset + stride])
        offset += stride
        if filt == 1:
            for x in range(stride):
                left = row[x - bpp] if x >= bpp else 0
                row[x] = (row[x] + left) & 255
        elif filt == 2:
            for x in range(stride):
                row[x] = (row[x] + prev[x]) & 255
        elif filt == 3:
            for x in range(stride):
                left = row[x - bpp] if x >= bpp else 0
                row[x] = (row[x] + ((left + prev[x]) // 2)) & 255
        elif filt == 4:
            for x in range(stride):
                a = row[x - bpp] if x >= bpp else 0
                b = prev[x]
                c = prev[x - bpp] if x >= bpp else 0
                p = a + b - c
                pa, pb, pc = abs(p - a), abs(p - b), abs(p - c)
                pr = a if pa <= pb and pa <= pc else (b if pb <= pc else c)
                row[x] = (row[x] + pr) & 255
        rows.append(row)
        prev = row

    opaque = 0
    for row in rows:
        for x in range(width):
            if color_type == 6:
                if row[x * 4 + 3] >= 30:
                    opaque += 1
            elif color_type == 4:
                if row[x * 2 + 1] >= 30:
                    opaque += 1
            elif color_type == 3:
                idx = row[x]
                alpha = trns[idx] if trns and idx < len(trns) else 255
                if alpha >= 30:
                    opaque += 1
            else:
                opaque += 1
    return opaque


def classify(icon_path: str) -> str | None:
    count = opaque_pixels(icon_path)
    if count is None:
        return None
    # Packaged Handy icons: idle 946, recording 766, transcribing 1028.
    if abs(count - 766) < 40:
        return "recording"
    if abs(count - 1028) < 40:
        return "transcribing"
    if abs(count - 946) < 40:
        return "idle"
    return None


def state_from_log() -> str | None:
    log = os.path.join(
        os.environ.get("XDG_DATA_HOME", os.path.expanduser("~/.local/share")),
        "com.pais.handy/logs/handy.log",
    )
    try:
        with open(log, "rb") as handle:
            handle.seek(0, os.SEEK_END)
            size = handle.tell()
            handle.seek(max(0, size - 65536))
            tail = handle.read().decode("utf-8", "replace")
    except OSError:
        return None
    for line in reversed(tail.splitlines()):
        if "tray icon change (Recording)" in line:
            return "recording"
        if "tray icon change (Transcribing)" in line:
            return "transcribing"
        if "tray icon change (Idle)" in line:
            return "idle"
    return None


def emit(state: str, last: str | None) -> str:
    if state != last:
        print(state, flush=True)
    return state


def main() -> int:
    last: str | None = None
    while True:
        handy = find_handy()
        state = "idle"
        if handy:
            dest, path = handy
            icon = item_prop(dest, path, "IconName")
            theme = item_prop(dest, path, "IconThemePath")
            candidates = []
            if icon:
                candidates.append(icon)
                if theme and not icon.startswith("/"):
                    candidates.append(os.path.join(theme, icon + ".png"))
                    candidates.append(os.path.join(theme, icon))
            for candidate in candidates:
                classified = classify(candidate)
                if classified:
                    state = classified
                    break
            else:
                state = state_from_log() or "idle"
        else:
            state = state_from_log() or "idle"
        last = emit(state, last)
        time.sleep(0.15)
    return 0


if __name__ == "__main__":
    try:
        sys.exit(main())
    except KeyboardInterrupt:
        sys.exit(0)
